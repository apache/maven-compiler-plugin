<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.apache.maven.plugins.compiler.it</groupId>
  <artifactId>incremental-proc-none-per-file</artifactId>
  <version>1.0-SNAPSHOT</version>

  <description>Verifies the explicit per-file incremental strategy (options,dependencies,sources)
    when annotation processing is disabled (proc=none). The default since this PR is
    options,dependencies,sources,rebuild-on-change for all projects; users who want faster
    (but potentially unsafe) per-file compilation must opt in explicitly.
    This IT modifies one of three independent classes between two 'compile' invocations and asserts
    that only the modified file is recompiled when per-file mode is requested explicitly.</description>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>@project.version@</version>
          <configuration>
            <!-- Explicitly opt in to per-file incremental compilation.
                 The default (rebuild-on-change) would recompile all files on any change;
                 this test verifies that the opt-in per-file strategy works correctly. -->
            <proc>none</proc>
            <incrementalCompilation>options,dependencies,sources</incrementalCompilation>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <!-- Called as second invoker goal to modify a single source file in place. -->
        <groupId>org.codehaus.gmaven</groupId>
        <artifactId>groovy-maven-plugin</artifactId>
        <version>2.1.1</version>
        <configuration>
          <source>def f = new File( project.basedir, 'src/main/java/it/A.java' )
            f.write( f.text.replaceAll( /return 1;/, 'return 999;' ) )</source>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.codehaus.groovy</groupId>
            <artifactId>groovy-all</artifactId>
            <version>2.4.21</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
